{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; worker-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ],
  "cloudFunctions": {
    "maxDuration": 120
  },
  "schedules": [
    {
      "name": "daily-cleanup",
      "cron": "23 3 * * *",
      "timezone": "Asia/Shanghai",
      "method": "POST",
      "path": "/api/scheduled-cleanup"
    }
  ]
}
